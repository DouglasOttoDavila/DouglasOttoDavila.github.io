{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operational Context Graph Dataset",
  "type": "object",
  "required": [
    "meta",
    "nodes",
    "links"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "name",
        "version",
        "format",
        "isFictional"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "nodes-links"
          ]
        },
        "nodeCount": {
          "type": "integer"
        },
        "linkCount": {
          "type": "integer"
        },
        "isFictional": {
          "type": "boolean"
        }
      }
    },
    "nodeTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "edgeTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "type",
          "group"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "type"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    }
  }
}