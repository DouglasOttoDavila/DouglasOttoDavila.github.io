---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section class="contact-band section-shell" aria-labelledby="contact-title">
  <div>
    <p class="section-context">The next quality problem</p>
    <h2 id="contact-title">Need stronger evidence before the next release?</h2>
  </div>
  <div class="contact-band-actions">
    <a class="button button-primary" href={`mailto:${site.email}`}><Icon name="mail" size={19} /> Email Douglas</a>
    <a class="button button-secondary" href={site.calendar} target="_blank" rel="noreferrer">Book a conversation <Icon name="external" size={18} /></a>
  </div>
</section>
