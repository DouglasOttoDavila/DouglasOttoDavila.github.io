---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import TerminalProjectPreview from '../../components/TerminalProjectPreview.astro';
import ContactBand from '../../components/ContactBand.astro';
const order=['user-story-evaluator','context-graph','neural-test-signal-classifier','ai-document-generator'];
const projects=(await getCollection('projects')).sort((a,b)=>order.indexOf(a.id)-order.indexOf(b.id));
---
<BaseLayout title="Work — Douglas D'Avila" description="Projects in quality engineering, automation, and delivery evidence." current="work"><header class="page-hero section-shell"><p class="section-context">Selected work</p><h1>Tools and systems for higher quality software.</h1><p>Practical work, organized around the quality problem it addresses.</p></header><section class="project-index section-shell" aria-label="Projects">{projects.map(p=><article class="project-index-row"><div class="studio-only"><ProjectPreview id={p.id}/></div><TerminalProjectPreview id={p.id}/><div><span class="status-badge">{p.data.status} · {p.data.year}</span><h2><a href={`/work/${p.id}`}>{p.data.title}</a></h2><p>{p.data.description}</p><p class="skills-line">{p.data.skills.join(' · ')}</p><a class="text-link" href={`/work/${p.id}`}>Explore project →</a></div></article>)}</section><ContactBand/></BaseLayout>
