---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBand from '../components/ContactBand.astro';
import { site } from '../data/site';
const roles=(await getCollection('experience')).sort((a,b)=>b.data.sequence-a.data.sequence);
---
<BaseLayout title="Experience — Douglas D'Avila" description="From technical operations to SDET: Douglas D'Avila's experience." current="experience">
<header class="page-hero experience-hero section-shell"><div><p class="section-context">Experience</p><h1>A career built on making systems clearer.</h1><p>I work at the intersection of people, processes, and technology, using testing and automation to turn complexity into clarity.</p><a class="button button-primary" href={site.resume} target="_blank" rel="noreferrer">Open résumé ↗</a></div><aside class="evolution-note"><h2>How the work evolved</h2><p>My path started in operational support, where I learned to diagnose real problems and work close to users. Over time, I moved into engineering, building automation, improving test architecture, and applying engineering judgment.</p><p>Different roles, same focus: understand, simplify, improve.</p></aside></header>
<section class="career-timeline section-shell" aria-label="Professional experience, most recent first">{roles.map((role,index)=><article class:list={['career-entry',{'is-current':index===0}]}><p class="career-date">{role.data.start} – {role.data.end}</p><div class="career-content"><svg class="career-path" viewBox="0 0 20 200" preserveAspectRatio="none" aria-hidden="true"><path d="M10 0 C-3 55 23 145 10 200" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><div class="career-identity"><div class="career-heading"><h2 title={role.data.role}>{index===0 ? "SDET" : role.data.sequence===3 ? "QA Engineer" : role.data.role}</h2>{index===0&&<span class="status-badge">Current role</span>}</div><p class="career-company">{role.data.company} · {role.data.location}</p></div><div class="career-narrative"><p>{role.data.summary}</p><details open={index===0}><summary>Role details</summary><ul>{role.data.responsibilities.map(item=><li>{item}</li>)}</ul><p class="skills-line">{role.data.skills.join(' · ')}</p></details></div></div></article>)}</section><ContactBand/></BaseLayout>
