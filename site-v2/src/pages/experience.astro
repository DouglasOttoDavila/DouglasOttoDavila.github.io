---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBand from '../components/ContactBand.astro';

const roles=(await getCollection('experience')).sort((a,b)=>b.data.sequence-a.data.sequence);
---
<BaseLayout title="Experience — Douglas D'Avila" description="From technical operations to SDET: Douglas D'Avila's experience." current="experience">
<header class="page-hero experience-hero section-shell"><div><p class="section-context">Experience</p><h1>A career built on making systems clearer.</h1><p>I work at the intersection of people, processes, and technology, using testing and automation to turn complexity into clarity.</p></div><aside class="evolution-note"><h2>How the work evolved</h2><p>My path started in operational support, where I learned to diagnose real problems and work close to users. Over time, I moved into engineering, building automation, improving test architecture, and applying engineering judgment.</p><p>Different roles, same focus: understand, simplify, improve.</p></aside></header>
<section class="resume-section section-shell" aria-labelledby="resume-summary"><p class="section-context">Professional profile</p><div><h2 id="resume-summary">QA Architect · SDET · AI-driven solutions</h2><p>AI-driven QA Architect and SDET with 5+ years of experience designing automation strategies, building scalable test frameworks, and delivering SDLC-enhancement tools for global eCommerce and enterprise platforms. I combine hands-on engineering with leadership in Agile environments, turning QA bottlenecks into practical automation, AI-assisted analysis, and reusable workflows.</p><h3>What I bring</h3><ul><li>AI-powered test generation, requirements validation, defect analysis, and visual regression interpretation.</li><li>Hands-on engineering across UI, API, CI/CD, performance, and test management workflows.</li><li>Automation leadership and mentoring, including a 40% reduction in manual intervention in pipeline-driven testing.</li><li>Business requirements translated into test strategy, automation architecture, and executable coverage.</li></ul><h3>Technical skills</h3><dl class="resume-skills">
<div><dt>Languages</dt><dd>Python, JavaScript, TypeScript, Java</dd></div><div><dt>Test automation</dt><dd>Playwright, Selenium, Cypress, WebdriverIO, Robot Framework</dd></div><div><dt>API & integration</dt><dd>Postman, REST Assured, REST APIs, service-level validation</dd></div><div><dt>CI/CD & DevOps</dt><dd>Jenkins, GitHub Actions, Bitbucket, Docker, pipeline automation</dd></div><div><dt>AI & LLM tools</dt><dd>Azure AI, OpenAI, Gemini, AI-assisted SDLC workflows</dd></div><div><dt>Performance</dt><dd>JMeter, load and performance validation</dd></div><div><dt>Test management</dt><dd>TestRail, Zephyr, traceability, coverage analysis</dd></div><div><dt>Collaboration & delivery</dt><dd>Jira, MantisBT, Scrum, Kanban, cross-functional leadership</dd></div></dl></div></section><section class="career-timeline section-shell" aria-label="Professional experience, most recent first">{roles.map((role,index)=><article class:list={['career-entry',{'is-current':index===0}]}><p class="career-date">{role.data.start} – {role.data.end}</p><div class="career-content"><svg class="career-path" viewBox="0 0 20 200" preserveAspectRatio="none" aria-hidden="true"><path d="M10 0 C-3 55 23 145 10 200" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><div class="career-identity"><div class="career-heading"><h2 title={role.data.role}>{index===0 ? "SDET" : role.data.sequence===3 ? "QA Engineer" : role.data.role}</h2>{index===0&&<span class="status-badge">Current role</span>}</div><p class="career-company">{role.data.company} · {role.data.location}</p></div><div class="career-narrative"><p>{role.data.summary}</p><details open={index===0}><summary>Role details</summary><ul>{role.data.responsibilities.map(item=><li>{item}</li>)}</ul><p class="skills-line">{role.data.skills.join(' · ')}</p></details></div></div></article>)}</section><section class="resume-section section-shell" aria-labelledby="resume-work"><p class="section-context">AI & automation</p><div><h2 id="resume-work">Practical tools for quality engineering.</h2><ul><li><strong>Test generation and recommendation:</strong> use story context and existing test assets to suggest relevant coverage.</li><li><strong>Requirements review:</strong> evaluate user stories for quality, completeness, and testability.</li><li><strong>Defect and result analysis:</strong> explore LLM-based summarization and classification to accelerate failure investigation.</li><li><strong>Visual regression intelligence:</strong> combine pixel-level differences with semantic AI review to distinguish regressions from visual noise.</li><li><strong>Workflow-based QA tooling:</strong> evolve custom Python/Flask utilities into modular AI and automation workflows.</li></ul><p>Across this work, I focus on maintainable automation architecture, practical AI adoption, mentoring quality engineers, and reliable enterprise delivery.</p></div></section>
<section class="resume-section section-shell" aria-labelledby="resume-education"><p class="section-context">Education & credentials</p><div><h2 id="resume-education">System Analysis & Development</h2><p>Technology Degree · UniRitter · 2021–2023</p><h3>Certifications</h3><ul><li>AWS Academy Graduate — AWS Academy Cloud Foundations · Amazon Web Services · May 2023</li><li>Red Hat OpenShift I: Containers & Kubernetes (DO180) · Red Hat · May 2023</li><li>JavaScript Algorithms and Data Structures · freeCodeCamp · December 2022</li><li>API Test Automation with Postman · Udemy · March 2022</li><li>Cypress Discovery (Cypress, JavaScript, Node.js, GitHub Actions) · QASkills · March 2022</li><li>Developer Accessibility Fundamentals I · eSSENTIAL Accessibility · August 2021</li></ul><h3>Languages</h3><p>Brazilian Portuguese: native · English: C2 proficient</p></div></section><ContactBand/></BaseLayout>
