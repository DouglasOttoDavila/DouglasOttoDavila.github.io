---
/* THESIS: role and evidence together. OWN-WORLD: daylight, forest green, Onest, flat artifacts.
STORY: understand, inspect, explore, contact. FIRST VIEWPORT: concise intro left, readable workflow right.
FORM: approved Home board with specification's connected section sequence. */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Workflow from '../components/Workflow.astro';
import TerminalDelivery from '../components/TerminalDelivery.astro';
import Icon from '../components/Icon.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import ContactBand from '../components/ContactBand.astro';
const projects=await getCollection('projects');
const featured=projects.find(p=>p.id==='user-story-evaluator')!;
const supporting=['context-graph','ai-document-generator'].map(id=>projects.find(p=>p.id===id)!);
const articles=(await getCollection('writing')).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf()).slice(0,2);
---
<BaseLayout title="Douglas D'Avila — SDET & Quality Engineering" description="Practical quality systems that connect requirements, automation, and engineering judgment.">
<section class="hero section-shell"><div class="hero-copy"><p class="section-context studio-only">Engineering better software</p><div class="terminal-only"><p class="terminal-command"><span class="terminal-cursor" aria-hidden="true">&gt;</span>whoami</p><p class="terminal-intro">Douglas D’Avila</p></div><h1>Quality systems,<br/>built for real delivery.</h1><p class="hero-role">SDET / Quality engineering / Practical AI</p><p>I design and build practical quality systems that connect requirements, reliable automation, and engineering judgment.</p><div class="hero-actions"><a class="button button-primary" href="#work">Explore selected work ↓</a><a class="text-link" href="/experience">View experience →</a></div></div><Workflow/><TerminalDelivery/></section>
<section id="work" class="selected-work section-shell" aria-labelledby="work-title"><div class="section-heading"><div><p class="section-context"><span class="studio-only">Selected work</span><span class="terminal-only">ls work/</span></p><h2 id="work-title"><span class="studio-only">Tools and systems for<br/>higher quality software.</span><span class="terminal-only">Selected work</span></h2></div><a class="text-link" href="/work">All projects →</a></div>
<div class="work-composition studio-only"><article class="featured-project"><ProjectPreview id={featured.id}/><div><h3>{featured.data.title}</h3><p>{featured.data.description}</p><a class="text-link" href={`/work/${featured.id}`}>Explore project →</a></div></article><div class="supporting-projects">{supporting.map(p=><article><span class="project-mini"><Icon name={p.id === "context-graph" ? "nodes" : "article"} size={48}/></span><div><h3>{p.data.title}</h3><p>{p.data.description}</p><a class="text-link" href={`/work/${p.id}`}>Explore project →</a></div></article>)}</div></div><ul class="terminal-only terminal-project-list">{[featured,...supporting].map(p=><li><a href={`/work/${p.id}`}><strong>{p.data.title}</strong><span>{p.data.description}</span><Icon name="arrow" size={22}/></a></li>)}</ul></section>
<div class="overview-rows section-shell">
<section id="experience" aria-labelledby="experience-title"><p class="section-context">Career overview</p><div class="overview-content"><h2 id="experience-title">A consistent focus on quality and delivery.</h2><p>From technical support and operations to QA automation leadership and SDET work.</p><p class="mini-timeline">Operations → Automation → Quality systems</p><a class="text-link" href="/experience">Full experience →</a></div></section>
<section id="writing" aria-labelledby="writing-title"><p class="section-context">Latest writing</p><div class="overview-content"><h2 id="writing-title" class="sr-only">Latest writing</h2>{articles.map(a=><article><h3><a href={a.data.externalUrl} target="_blank" rel="noreferrer">{a.data.title} ↗</a></h3><time datetime={a.data.publishedAt.toISOString()}>{a.data.publishedAt.toLocaleDateString('en',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></article>)}<a class="text-link" href="/writing">All writing →</a></div></section>
<section id="lab" aria-labelledby="lab-title"><p class="section-context">The Lab</p><div class="overview-content"><h2 id="lab-title">Small experiments. Inspectable decisions.</h2><p>Four experiments exploring requirements, delivery context, test signals, and documentation.</p><a class="text-link" href="/lab">Explore the Lab →</a></div></section>
<section id="about" aria-labelledby="about-title"><p class="section-context">A bit about me</p><div class="overview-content"><h2 id="about-title">Curious by nature, pragmatic by practice.</h2><p>I’m Douglas D’Avila, an SDET based in Porto Alegre, Brazil. I turn complex problems into understandable, dependable systems.</p><a class="text-link" href="/about">More about me →</a></div></section>
</div><ContactBand overview/></BaseLayout>
