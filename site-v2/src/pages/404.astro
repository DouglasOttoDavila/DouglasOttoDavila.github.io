---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found — Douglas D'Avila" description="This route does not exist.">
  <section class="not-found section-shell">
    <div class="terminal-only terminal-error-code" aria-hidden="true">404</div><p class="section-context">404 · Missing signal</p>
    <h1>This path left no evidence.</h1>
    <p>The page may have moved, or the route was never part of the system.</p>
    <a class="button button-primary" href="/">Return home →</a><a class="terminal-only text-link" href="/work">Explore work →</a>
  </section>
</BaseLayout>
